<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HavenLifeOnSource</AssemblyName>
    <RootNamespace>HavenLifeOnSource</RootNamespace>
    <Version>1.4.3</Version>
    <LangVersion>latest</LangVersion>
    <!-- Haven install folder (the one with Haven.exe). Override with -p:HavenDir=... or the HAVEN_DIR environment variable. -->
    <HavenDir Condition="'$(HavenDir)' == '' and '$(HAVEN_DIR)' != ''">$(HAVEN_DIR)</HavenDir>
    <HavenDir Condition="'$(HavenDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Haven</HavenDir>
    <HavenManaged>$(HavenDir)\Haven_Data\Managed</HavenManaged>
    <BepInExCore>$(HavenDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- References come from your own Haven + BepInEx install; none of them are shipped with this mod. -->
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(HavenManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Ink-Runtime"><HintPath>$(HavenManaged)\Ink-Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PlayMaker"><HintPath>$(HavenManaged)\PlayMaker.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(HavenManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(HavenManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
